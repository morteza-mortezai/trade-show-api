{
  "name": "api2",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "db:create": "npx mikro-orm schema:create --run --config ./src/config/mikro-orm.config.js",
    "db:update": "npx mikro-orm schema:update --run --config ./src/config/mikro-orm.config.js ",
    "db:drop": "npx mikro-orm schema:drop --run --config ./src/config/mikro-orm.config.js",
    "db:refresh": "npm run db:drop && npm run db:create ",
    "db:reset": "npm run db:drop && npm run db:create && npm run migration:up && npm run db:seed",
    "db:seed": "npm run seed:users",
    "migration:create": "npx mikro-orm migration:create --config ./src/config/mikro-orm.config.js",
    "migration:blank": "npx mikro-orm migration:create --blank --config ./src/config/mikro-orm.config.js",
    "migration:up": "npx mikro-orm migration:up --config ./src/config/mikro-orm.config.js",
    "migration:down": "npx mikro-orm migration:down --config ./src/config/mikro-orm.config.js",
    "migration:list": "npx mikro-orm migration:list --config ./src/config/mikro-orm.config.js",
    "migration:pending": "npx mikro-orm migration:pending --config ./src/config/mikro-orm.config.js",
    "migration:fresh": "npx mikro-orm migration:fresh --config ./src/config/mikro-orm.config.js",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "seed:users": "npm run build && node dist/database/seeders/seed-users.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@mikro-orm/core": "6.6.0",
    "@mikro-orm/migrations": "6.6.0",
    "@mikro-orm/nestjs": "^6.1.2",
    "@mikro-orm/sqlite": "^6.6.0",
    "@nestjs/axios": "^12.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/mapped-types": "*",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "decimal.js": "^10.6.0",
    "joi": "^18.2.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@mikro-orm/cli": "6.6.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
